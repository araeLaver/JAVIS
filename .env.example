# =============================================================================
# JAVIS Environment Configuration
# =============================================================================

# Storage Mode: local (default) or cloud
JAVIS_STORAGE_MODE=local

# =============================================================================
# Cloud Storage (Required if JAVIS_STORAGE_MODE=cloud)
# =============================================================================

# Supabase (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# HuggingFace Hub (from HuggingFace Settings -> Access Tokens)
HF_TOKEN=hf_xxxxx
HF_REPO_ID=your-username/javis-adapters

# =============================================================================
# Model Providers
# =============================================================================

# RunPod Configuration
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# Modal.com (for remote training)
MODAL_TOKEN_ID=ak-xxxxxxxxxxxxx
MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxx

# Discord Webhook (for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Groq API (for STT)
GROQ_API_KEY=your_groq_api_key_here

# Phase 7: External Service Integrations
# Google Calendar
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json

# Notion
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxx

# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxx

# Application Settings
JAVIS_ENV=development
JAVIS_LOG_LEVEL=INFO
JAVIS_DATA_DIR=./data

# Security Settings
# CORS allowed origins (comma-separated list)
# Leave empty for development defaults (localhost only)
# Example for production: https://myapp.com,https://api.myapp.com
CORS_ORIGINS=
